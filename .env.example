# Copy to .env and fill in your values
# .env is never committed — it stays on the Pi only

GAME_VERSION=poe2
LEAGUE_NAME=Return of the Ancients
REFRESH_INTERVAL_SECONDS=60
MIN_MARGIN_PCT=3.0
MIN_ABSOLUTE_PROFIT_CHAOS=5.0
MIN_VOLUME=10
MAX_HOP_DEPTH=4

# Optional: Discord webhook for opportunity alerts
DISCORD_WEBHOOK_URL=

# Notifications
NOTIFY_ON_NEW_OPPORTUNITY=true
NOTIFY_MIN_MARGIN_PCT=5.0

# Set by Dockerfile — only override if running locally without Docker
BIND_ALL_INTERFACES=true
